[Unit]
Description=Deploy the agent project from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Invoked via bash so a lost exec bit (git on Windows does not track mode)
# cannot break deployment.
ExecStart=/bin/bash /opt/langgraph-platform/deploy.sh
StandardOutput=append:/var/log/langgraph-deploy.log
StandardError=append:/var/log/langgraph-deploy.log
