# Which project to deploy. Filled in once the AI engineer's repo exists.
# Copy to /etc/langgraph/deploy.env. deploy.sh does nothing while REPO is empty,
# so the timer can be enabled before there is anything to deploy.
REPO=
BRANCH=

# Where the app is served for n8n. 172.18.0.1 is the n8n_web docker bridge
# gateway: the n8n CONTAINER reaches the host on this address. Deliberately not
# 0.0.0.0 -- ufw is inactive on this box, so 0.0.0.0 would publish the agent to
# the internet on port 8000.
BIND_ADDR=172.18.0.1
API_PORT=8000
